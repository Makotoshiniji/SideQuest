# VITE_GEMINI_API_KEY: Required for Gemini AI API calls.
# Get this from: https://aistudio.google.com/apikey
# In development, copy this file to .env.local and fill in the actual value
# In production, set via environment variables or Firebase secret management
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# VITE_APP_URL: The URL where this applet is hosted.
# For development: http://localhost:3000
# For production: https://side-quest-5f019.web.app/
VITE_APP_URL=http://localhost:3000

# Note: Firebase configuration is already embedded in src/firebase.ts
# and uses the firebaseConfig object with the project credentials.

